# Claude API 키 (필수 — LLM 에이전트가 대화를 진행. 없으면 첫 응답에서 안내 후 상담원 콜백으로 종료)
ANTHROPIC_API_KEY=
# SQLite 파일 경로 (prisma/ 기준)
DATABASE_URL="file:./dev.db"
# 에이전트 LLM 모델 (데모 권장: claude-haiku-5-5 — 빠름)
LLM_MODEL=claude-haiku-5-5
# 추론 강도: low | medium | high | xhigh | max (높을수록 느림 — 전화 대화엔 low 권장)
LLM_EFFORT=low
# LLM 호출 1회 제한 시간 (ms). 초과·오류 시 1회 재시도 후 폴백 안내
LLM_TIMEOUT_MS=10000
# 한 턴에서 허용하는 LLM 호출(tool 루프) 최대 횟수
AGENT_MAX_STEPS=5
# (선택) 평가·데모용 현재 시각 고정, 예: 2026-11-26T11:00:00+09:00
AGENT_NOW=
API_PORT=3001

# 서버 TTS (Typecast). 없으면 브라우저 TTS 사용
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=tc_6a21054564d676539427427e
TYPECAST_VOICE_NAME=혜진
TTS_TEMPO=0.88
TTS_TIMEOUT_MS=8000
# Typecast 동시 요청 수 (Free 플랜: 2)
TTS_CONCURRENCY=2
