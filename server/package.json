{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:setup": "ts-node prisma/drop-fts.ts && prisma db push --skip-generate && prisma generate && ts-node prisma/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('prisma/dev.db',{force:true})\" && npm run db:setup",
    "test": "jest --runInBand",
    "eval": "ts-node eval/run-eval.ts",
    "db:studio": "prisma studio --browser none --port 5555"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
